<?xml version="1.0" encoding="utf-8"?>
<!-- Свои значки для знамён. Ванильные группы игры (фоны, звери, растения, рукотворное, знаки,
     фигуры) остаются на месте — эта добавляется к ним седьмой.

     Значки лежат листом 2048x2048 по 4x4 клетки (см. tools/make_banner_icons.py), номер клетки —
     texture_index, от 0 до 15 слева направо и сверху вниз. Материал eq_banner_icons делается
     копией ванильного (tools/banner_material.ps1) после того, как лист импортирован в редакторе.

     Сейчас все шестнадцать клеток — белый лист с чёрной каёмкой: это проверка размеров.
     Подробности — docs/banners.md. -->
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	type="string">
	<BannerIconData>
		<BannerIconGroup
			id="7"
			name="{=eq_banner_group}Equestria"
			is_pattern="false">
			<Icon id="900" material_name="eq_banner_icons" texture_index="0" />
