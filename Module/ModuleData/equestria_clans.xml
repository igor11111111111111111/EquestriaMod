	<Faction id="player_faction" initial_home_settlement="Settlement.town_empire_0" name="{=o0Xm5Rqk}Playerland" tier="0" />
	<Faction id="looters" initial_home_settlement="Settlement.town_empire_1" name="{=looters_name}Looters" short_name="{=looters_short}Looters" text="{=looters_text}The rabble that follows every war: ruined traders, runaway farmhands and plain idlers with clubs. Alone they are cowards, but a starving mob will face even a patrol." tier="1" />
	<Faction id="deserters" initial_home_settlement="Settlement.town_empire_2" name="{=deserters_name}Deserters" short_name="{=deserters_short}Deserters" text="{=deserters_text}Guardsponies and militia who dropped their banner mid-campaign. Their weapons are good, their conscience is not, and there is no way back: Equestria judges desertion harshly." tier="1" />
	<Faction id="sea_raiders" initial_home_settlement="Settlement.town_empire_3" name="{=sea_raiders_name}The Storm King's Host" short_name="{=sea_raiders_short}The Storm Host" text="{=sea_raiders_text}Remnants of the Storm King's army that never laid down their arms after his fall. They come from the sea in black ships and take what their master once promised them." tier="1" />
	<Faction id="mountain_bandits" initial_home_settlement="Settlement.town_empire_4" name="{=mountain_bandits_name}Diamond Dogs" short_name="{=mountain_bandits_short}Diamond Dogs" text="{=mountain_bandits_text}The dogs dig gems in mountain burrows and find another's labour sweeter than their own. They snatch ponies not from malice but for their nose for precious stones." tier="1" />
	<Faction id="forest_bandits" initial_home_settlement="Settlement.town_empire_5" name="{=forest_bandits_name}Timberwolves" short_name="{=forest_bandits_short}Timberwolves" text="{=forest_bandits_text}Packs of deadwood and vine that assemble themselves in the Everfree thickets. Cut one in half and a day later two of them run the woods." tier="1" />
	<Faction id="desert_bandits" initial_home_settlement="Settlement.town_empire_6" name="{=desert_bandits_name}Vultures of the Badlands" short_name="{=desert_bandits_short}Vultures" text="{=desert_bandits_text}Scavengers of the wastes beyond the changeling hives. They do not attack the strong: they wait until a caravan weakens from thirst and pick up what is left." tier="1" />
	<Faction id="steppe_bandits" initial_home_settlement="Settlement.town_empire_7" name="{=steppe_bandits_name}Steppe Jackals" short_name="{=steppe_bandits_short}Steppe Jackals" text="{=steppe_bandits_text}Mounted gangs of the plains who live by raiding herds and wagon trains. They know the steppe better than any patrol and melt into the grass before help arrives." tier="1" />
	<Faction id="ghilman" initial_home_settlement="Settlement.town_aserai_2" name="{=ghilman_name}Abyssinian Mercenaries" short_name="{=ghilman_short}Abyssinians" text="{=ghilman_text}A company started by Abyssinian cats out of Klugetown now takes whoever comes, and most of all changelings from the nearby hives: they will change shape and work for the feelings of others. The old name is kept on purpose — it commands a higher fee." tier="4" />
	<Faction id="legion_of_the_betrayed" initial_home_settlement="Settlement.town_empire_8" name="{=legion_of_the_betrayed_name}Moon Wolves" short_name="{=legion_of_the_betrayed_short}Moon Wolves" text="{=legion_of_the_betrayed_text}Night ponies and thestrals who once served in the Night Guard and now sell their wings. They fight in the dark as surely as others fight by daylight." tier="4" />
	<Faction id="skolderbrotva" initial_home_settlement="Settlement.town_sturgia_2" name="{=skolderbrotva_name}Free Blades of Klugetown" short_name="{=skolderbrotva_short}Free Blades" text="{=skolderbrotva_text}Harbour rabble where young dragons have taken the upper hand: scales stop a blow better than any armour, and greed for gold passes for discipline. They are no shame to their town — there, too, no one asks who you are." tier="4" />
	<Faction id="company_of_the_boar" initial_home_settlement="Settlement.town_vlandia_1" name="{=company_of_the_boar_name}Captain Celaeno's Sky Pirates" short_name="{=company_of_the_boar_short}Sky Pirates" text="{=company_of_the_boar_text}The crew of a griffon airship that sails below the clouds and levies toll on the sky roads. Celaeno remembers serving the Storm King and bows to no one now." tier="4" />
	<Faction id="beni_zilal" initial_home_settlement="Settlement.town_aserai_0" name="{=beni_zilal_name}Shadows of the Hive" short_name="{=beni_zilal_short}Shadows of the Hive" text="{=beni_zilal_text}Changelings who found home too small after the hives made their peace. They sell what they do best: walk in anywhere behind a borrowed face and strike first." tier="4" />
	<Faction id="wolfskins" initial_home_settlement="Settlement.town_battania_0" name="{=wolfskins_name}Blades of Mount Aris" short_name="{=wolfskins_short}Blades of Aris" text="{=wolfskins_text}Hippogriffs find both the land and the sea too narrow, so they hire out where both skills are paid for. Today the band marches along the shore, tomorrow it takes to the water and surfaces behind the enemy." tier="4" />
	<Faction id="brotherhood_of_woods" initial_home_settlement="Settlement.town_empire_14" name="{=brotherhood_of_woods_name}Brotherhood of the Everfree" short_name="{=brotherhood_of_woods_short}Brotherhood of the Woods" text="{=brotherhood_of_woods_text}Griffon rangers settled along the edge of the Everfree who know it better than any pony. For coin they will lead an army through the thickets where the maps run out, and will not ask why." tier="4" />
	<Faction id="hidden_hand" initial_home_settlement="Settlement.town_empire_5" name="{=hidden_hand_name}The Flim Flam Brothers' Enterprise" short_name="{=hidden_hand_short}Flim and Flam" text="{=hidden_hand_text}The unicorn brothers sell cider, tonics and miracles, and when the fraud comes out they wheel their cart to the next county. They hire swords so the takings reach the next fair." tier="3" />
	<Faction id="lakepike" initial_home_settlement="Settlement.town_sturgia_1" name="{=lakepike_name}Dragonfire" short_name="{=lakepike_short}Dragonfire" text="{=lakepike_text}Young dragons left without a cave or a hoard, earning their gold in other people's wars. They fight greedily and briefly: enough for a first pile of treasure, and home they go." tier="4" />
	<Faction id="embers_of_flame" initial_home_settlement="Settlement.town_empire_0" name="{=embers_of_flame_name}The Golden Horseshoe Company" short_name="{=embers_of_flame_short}Golden Horseshoe" text="{=embers_of_flame_text}An old earth pony mercenary company with a good name and a high price. They are not the first to run and they do not break a contract — that is what their fame rests on." tier="3" />
	<Faction id="jawwal" initial_home_settlement="Settlement.town_aserai_1" name="{=jawwal_name}Chrysalis's Faithful" short_name="{=jawwal_short}Chrysalis's Faithful" text="{=jawwal_text}Changelings who never accepted the peace between the hives, nor forgave their queen her defeat, yet cannot live without her either. They fight bitterly and for any coin, so long as it is against those who deposed Chrysalis." tier="4" />
	<Faction id="karakhuzaits" initial_home_settlement="Settlement.town_empire_25" name="{=karakhuzaits_name}Black Yaks" short_name="{=karakhuzaits_short}Black Yaks" text="{=karakhuzaits_text}Yaks banished from Yakyakistan for rowdiness even by yak standards. No one smashes better, and they hold the line as long as there is something to smash." tier="4" />
	<Faction id="forest_people" initial_home_settlement="Settlement.town_sturgia_0" name="{=forest_people_name}Garble's Gang" short_name="{=forest_people_short}Garble's Gang" text="{=forest_people_text}Teenage dragons whom the Dragon Lands write off as louts and other people's wars value as expensive shock troops. They have no discipline, but they have claws, wings and a keen wish to show off." tier="4" />
	<Faction id="eleftheroi" initial_home_settlement="Settlement.town_empire_23" name="{=eleftheroi_name}The Equals of Our Town" short_name="{=eleftheroi_short}The Equals" text="{=eleftheroi_text}A commune where every cutie mark is the same and talent is declared the root of discord. Those who leave to sell their swords have usually come to doubt equality, but kept the habit of holding formation." tier="3" />
</Factions>
