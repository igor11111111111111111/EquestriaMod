<!-- Колесо выбора заклинаний (удержание Q в бою) и строка маги снизу слева.

     CircleActionSelectorWidget — ванильный виджет: он сам раскладывает детей по кругу и по
     направлению ДВИЖЕНИЯ мыши ставит выбранному ребёнку IsSelected. Мы ничего своего на C#
     под интерфейс не пишем: выбранный пункт представление читает прямо из виджетов.
     Разбор устройства у The Old Realms — docs/tor_reference/04_magic.md, раздел 6. -->
<Prefab>
  <Constants>
    <!-- Размер луча прицела берём у ванильной кисти — тот же, что у лука и дротиков -->
    <Constant Name="Crosshair.Size" BrushName="Crosshair.Top" BrushLayer="Default" BrushValueType="Width" />
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Прицел на время наводки: четыре ванильных луча вокруг центра экрана -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="74" SuggestedHeight="74"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@CrosshairVisible">
          <Children>
            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="!Crosshair.Size" SuggestedHeight="!Crosshair.Size"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Brush="Crosshair.Top" />
            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="!Crosshair.Size" SuggestedHeight="!Crosshair.Size"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Brush="Crosshair.Bottom" />
            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="!Crosshair.Size" SuggestedHeight="!Crosshair.Size"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Brush="Crosshair.Left.Square" />
            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                         SuggestedWidth="!Crosshair.Size" SuggestedHeight="!Crosshair.Size"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Brush="Crosshair.Right.Square" />
          </Children>
        </Widget>

        <!-- Постоянная подсказка: выбранное заклинание и запас маны -->
        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="30"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    MarginLeft="30" MarginBottom="30"
                    Text="@HudText" IsVisible="@HudVisible" Brush.FontSize="22" />

        <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@IsVisible">
          <Children>

            <CircleActionSelectorWidget Id="SpellWheel" DataSource="{Items}"
                WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="450" SuggestedHeight="450"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                DirectionWidget="..\..\WheelPointer" ActivateOnlyWithController="false"
                DirectionWidgetDistanceMultiplier="0.7" DistanceFromCenterModifier="230"
                Sprite="BlankWhiteCircle" Color="#00000099">
              <ItemTemplate>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="170" SuggestedHeight="44"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Sprite="BlankWhiteSquare_9" Color="#161616EE">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Text="@Name" Brush.FontSize="20" />
                  </Children>
                </ButtonWidget>
              </ItemTemplate>
            </CircleActionSelectorWidget>

            <!-- Середина колеса: что выбрано, сколько стоит, сколько маны -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="260" SuggestedHeight="160"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Text="@CurrentName" Brush.FontSize="26" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Text="@CurrentCost" Brush.FontSize="20" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Text="@CurrentProblem" Brush.FontSize="20" Brush.FontColor="#EB3434FF" />
              </Children>
            </Widget>

          </Children>
        </Widget>

        <!-- Точка-указатель: летает от центра в сторону движения мыши -->
        <Widget Id="WheelPointer" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="13" SuggestedHeight="13"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteCircle" AlphaFactor="0.5" />

        <!-- Сообщение об ошибке каста -->
        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="-120"
                    Text="@MessageText" IsVisible="@MessageVisible"
                    Brush.FontSize="24" Brush.FontColor="#EB3434FF" />

      </Children>
    </Widget>
  </Window>
</Prefab>
