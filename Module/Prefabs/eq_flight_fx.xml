				<effect base_effect="{FC91714C-B292-49A6-8BBA-8E379D48906B}">
					<emitter_overrides>
						<emitter guid="{12D167CF-412F-4F18-9405-FDFBB0B88D6A}">
							<flags>
								<flag name="emit_while_moving" value="false"/>
								<flag name="dont_emit_while_moving" value="false"/>
								<flag name="emit_on_terrain" value="false"/>
							</flags>
							<parameters>
								<parameter name="inherit_emitter_velocity" value="0.300"/>
								<parameter name="emit_box_size" value="0.600, 0.600, 0.100"/>
								<parameter name="gravity" value="0.000, 0.000, 0.150"/>
								<parameter name="emission_speed_limit" value="0.000"/>
								<parameter name="max_alive_particle_count" value="18"/>
								<parameter name="damping" base="0.500" bias="0.050"/>
								<parameter name="particle_life" base="1.600" bias="0.400"/>
								<parameter name="emission_rate" base="9.000" bias="0.000"/>
								<parameter name="emit_velocity_x" base="0.000" bias="0.300"/>
								<parameter name="emit_velocity_y" base="0.000" bias="0.300"/>
								<parameter name="emit_velocity_z" base="0.300" bias="0.100"/>
								<parameter name="emit_rotation_speed" base="0.000" bias="360.000"/>
								<parameter name="wind_effect" base="0.000" bias="0.000"/>
